generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  RECRUITER
  ADMIN
}

model User {
  id            String    @id @default(cuid())
  name          String?
  username      String    @unique
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?

  role Role @default(USER)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  accounts          Account[]
  sessions          Session[]
  resumes           Resume[]
  interviewSessions InterviewSession[]

  @@index([email])
  @@index([username])
}

model Account {
  id                String @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String

  refresh_token String? @db.Text
  access_token  String? @db.Text
  expires_at    Int?
  token_type    String?
  scope         String?
  id_token      String? @db.Text
  session_state String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Resume {
  id       String @id @default(cuid())
  title    String
  fileName String
  fileUrl  String
  fileSize Int
  mimeType String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  analysis ResumeAnalysis?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ResumeAnalysis {
  id String @id @default(cuid())

  resumeId String @unique
  resume   Resume @relation(fields: [resumeId], references: [id], onDelete: Cascade)

  atsScore Int

  extractedSkills   Json
  extractedProjects Json

  strengths  Json
  weaknesses Json

  missingKeywords Json
  suggestions     Json

  createdAt DateTime @default(now())
}

enum InterviewType {
  TECHNICAL
  HR
  SYSTEM_DESIGN
  BEHAVIORAL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum InterviewStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model InterviewSession {
  id            String          @id @default(cuid())
  userId        String
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  company       String?
  role          String
  interviewType InterviewType
  difficulty    Difficulty
  status        InterviewStatus @default(NOT_STARTED)
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  questions InterviewQuestion[]

  @@index([userId])
}

model InterviewQuestion {
  id                 String           @id @default(cuid())
  interviewSessionId String
  interviewSession   InterviewSession @relation(fields: [interviewSessionId], references: [id], onDelete: Cascade)
  question           String           @db.Text
  expectedTopics     Json
  order              Int
  createdAt          DateTime         @default(now())

  answers InterviewAnswer[]

  @@index([interviewSessionId])
}

model InterviewAnswer {
  id                  String            @id @default(cuid())
  interviewQuestionId String
  interviewQuestion   InterviewQuestion @relation(fields: [interviewQuestionId], references: [id], onDelete: Cascade)
  answer              String            @db.Text
  durationSeconds     Int?
  createdAt           DateTime          @default(now())

  feedback InterviewFeedback?

  @@index([interviewQuestionId])
}

model InterviewFeedback {
  id                 String          @id @default(cuid())
  interviewAnswerId  String          @unique
  interviewAnswer    InterviewAnswer @relation(fields: [interviewAnswerId], references: [id], onDelete: Cascade)
  score              Int
  strengths          Json
  weaknesses         Json
  suggestions        Json
  communicationScore Int?
  technicalScore     Int?
  confidenceScore    Int?
  overallFeedback    String          @db.Text
  createdAt          DateTime        @default(now())
}
